@using static CinemaApp.GCommon.ApplicationConstants;

@if(TempData[ErrorTempDataKey] != null)
{
    <script>
        toastr.error("@TempData[ErrorTempDataKey]");
    </script>
} else if (TempData[SuccessTempDataKey] != null)
{
    <script>
        toastr.error("@TempData[SuccessTempDataKey]");
    </script>
}
else if (TempData[InfoTempDataKey] != null)
{
    <script>
        toastr.error("@TempData[InfoTempDataKey]");
    </script>
}
else if (TempData[WarningTempDataKey] != null)
{
    <script>
        toastr.error("@TempData[WarningTempDataKey]");
    </script>
}