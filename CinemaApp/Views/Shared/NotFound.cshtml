@{
    ViewData["Title"] = "404 - Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="text-center text-light px-4">

        <div class="mb-4" style="font-size: 7rem; line-height: 1;">
            <i class="bi bi-camera-reels text-warning opacity-75"></i>
        </div>

        <h1 class="display-1 fw-bold text-warning" style="font-size: 8rem; letter-spacing: -4px;">
            404
        </h1>

        <h2 class="fw-bold mb-3" style="font-size: 1.8rem;">
            Тази сцена я няма
        </h2>

        <p class="text-secondary mb-2" style="font-size: 1.05rem; max-width: 480px; margin: 0 auto;">
            Страницата, която търсиш, е изрязана от монтажа.
            Може би е преместена, изтрита или никога не е снимана.
        </p>

        <div class="my-4 mx-auto" style="width: 60px; border-top: 2px solid #ffc107; opacity: 0.4;"></div>

        <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
            <a asp-controller="Movie" asp-action="Index"
               class="btn btn-warning fw-bold px-4 rounded-pill">
                <i class="bi bi-collection-play me-2"></i> Към филмите
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-light fw-bold px-4 rounded-pill">
                <i class="bi bi-house me-2"></i> Начало
            </a>
        </div>

    </div>
</div>
